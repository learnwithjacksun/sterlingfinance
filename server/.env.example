PORT=5000
NODE_ENV=development

# MongoDB. Must be a replica set (e.g. Atlas) so balance changes can run in transactions.
MONGO_URI=

# Long random string (32+ chars). Signs access tokens.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=45

# Browser origins allowed by CORS; also the base for links in emails. Comma separated.
CLIENT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Brevo (transactional email). The sender must be a verified sender/domain in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sterling Holdings

# Image hosting (avatars, KYC ID images). Uploaded server-side.
IMGBB_API_KEY=

# Infobip SMS (admin "send SMS" on a transaction)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=InfoSMS

# Used only by `npm run seed:admin`
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PASSCODE=
